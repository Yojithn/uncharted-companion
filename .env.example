# ─── AI providers for the Uncharted companion ─────────────────────────────
# Copy the lines you need into your .env file and paste each key after the =
# (no quotes, no spaces). Leave the rest empty: providers without a key are
# skipped. They're tried in this order, top to bottom.

# 1. Groq (fast, about 1,000 requests a day free): https://console.groq.com/keys
GROQ_API_KEY=

# 2. Mistral (free "Experiment" plan, needs phone verification): https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# 3. NVIDIA (40 requests a minute, needs phone verification): https://build.nvidia.com
NVIDIA_API_KEY=

# 4. Cerebras (free trial credits for 30 days): https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# 5. OpenRouter (50 free requests a day): https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# 6. Cohere (free trial key, 1,000 requests a month): https://dashboard.cohere.com/api-keys
COHERE_API_KEY=

# 7. Cloudflare Workers AI (small daily free allowance): https://dash.cloudflare.com
#    Go to AI > Workers AI > "Use REST API" to create a token and copy your account ID.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# 8. Hugging Face (tiny monthly free credit): https://huggingface.co/settings/tokens
HF_TOKEN=

# 9. Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 10. Ollama, a model on your own laptop (no key, no limits, but slower).
#     Install from https://ollama.com, run:  ollama pull gemma3:4b  then set:
OLLAMA_MODEL=
